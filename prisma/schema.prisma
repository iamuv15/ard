// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Chapter {
  id        Int              @id @default(autoincrement())
  name      String           @unique
  cohort    String           @default("BETA") // "ALPHA" or "BETA"
  order     Int              @default(0)
  quizzes   Quiz[]
  concepts  ChapterConcept[]
  mindMap   ChapterMindMap?
  createdAt DateTime         @default(now())
}

model Quiz {
  id        Int      @id @default(autoincrement())
  name      String
  chapterId Int
  chapter   Chapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  cohort    String   @default("BETA") // "ALPHA" or "BETA"
  order     Int      @default(0)
  questions Question[]
  attempts  QuizAttempt[]
  createdAt DateTime @default(now())
}

model Question {
  id            Int      @id @default(autoincrement())
  questionText  String
  optionA       String
  optionB       String
  optionC       String
  optionD       String
  optionE       String?
  explanationA  String?
  explanationB  String?
  explanationC  String?
  explanationD  String?
  explanationE  String?
  topic             String?
  explanation       String?
  simpleExplanation String?
  isEnriched        Boolean  @default(false)
  isMined           Boolean  @default(false)
  correctAnswer     String

  quizId        Int
  quiz          Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  mistakes      UserMistake[]
  bookmarks     UserBookmark[]
  reports       QuestionReport[]
  concepts      ChapterConcept[]
}

model ChapterMindMap {
  id          Int      @id @default(autoincrement())
  chapterId   Int      @unique
  chapter     Chapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  treeData    Json
  rawKeywords String[] @default([])
  lastSyncAt  DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ChapterConcept {
  id           Int        @id @default(autoincrement())
  chapterId    Int
  chapter      Chapter    @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  term         String
  slug         String
  category     String
  subCategory  String?
  definition   String
  content      String
  examTraps    String?
  relatedTerms String[]   @default([])
  imageUrl     String?
  thumbnailUrl String?
  imageCaption String?
  sourceUrl    String?
  videoUrl     String?
  order        Int        @default(0)
  isPublished  Boolean    @default(true)
  questions    Question[]
  mediaReports ConceptMediaReport[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([chapterId, slug])
  @@index([chapterId])
  @@index([category])
}

model ConceptMediaReport {
  id               Int            @id @default(autoincrement())
  conceptId        Int
  concept          ChapterConcept @relation(fields: [conceptId], references: [id], onDelete: Cascade)
  reportedByUserId Int?
  reportedBy       User?          @relation(fields: [reportedByUserId], references: [id], onDelete: SetNull)
  mediaType        String         // "IMAGE" or "VIDEO"
  reason           String         // "INACCURATE_BREED", "BROKEN_LINK", "IRRELEVANT", "OTHER"
  userNote         String?
  flaggedUrl       String?
  status           String         @default("PENDING") // "PENDING", "RESOLVED", "DISMISSED"
  resolvedAt       DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([conceptId])
  @@index([status])
}

model User {
  id        Int       @id @default(autoincrement())
  email     String    @unique
  password  String
  name      String
  role      String    @default("USER")
  cohort    String    @default("BETA") // "ALPHA" or "BETA"
  createdAt DateTime  @default(now())

  mistakes       UserMistake[]
  attempts       QuizAttempt[]
  bookmarks      UserBookmark[]
  reports        QuestionReport[]
  conceptReports ConceptMediaReport[]
}

model UserMistake {
  id         Int      @id @default(autoincrement())
  userId     Int
  questionId Int
  createdAt    DateTime @default(now())
  nextReviewAt DateTime @default(now())
  reviewLevel  Int      @default(0)

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
}

model QuizAttempt {
  id        Int      @id @default(autoincrement())
  userId    Int
  quizId    Int
  score     Int
  total     Int
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  quiz      Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
}

model UserBookmark {
  id         Int      @id @default(autoincrement())
  userId          Int
  questionId      Int
  importanceLevel String   @default("IMPORTANT")
  createdAt       DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
}

model QuestionReport {
  id               Int      @id @default(autoincrement())
  questionId       Int
  question         Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  reportedByUserId Int?
  reportedBy       User?    @relation(fields: [reportedByUserId], references: [id], onDelete: SetNull)

  reason           String   // e.g. "WRONG_ANSWER_KEY", "MULTIPLE_CORRECT", "NO_CORRECT", "TYPO_IN_QUESTION", "EXPLANATION_ERROR", "OUTDATED_INFO", "OTHER"
  userNote         String?  // Optional text typed by user if "Other" or note

  status           String   @default("PENDING_AI") // "PENDING_AI", "AUTO_CORRECTED", "NEEDS_ADMIN_REVIEW", "ADMIN_RESOLVED", "DISMISSED"
  aiConfidence     String?  // "HIGH", "MEDIUM", "LOW"
  aiReasoning      String?
  previousAnswer   String?
  suggestedAnswer  String?
  suggestedExplanation String?

  resolvedAt       DateTime?
  resolvedByAdmin  Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([questionId])
  @@index([status])
}
