// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Chapter {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  cohort    String   @default("BETA") // "ALPHA" or "BETA"
  quizzes   Quiz[]
  createdAt DateTime @default(now())
}

model Quiz {
  id        Int      @id @default(autoincrement())
  name      String
  chapterId Int
  chapter   Chapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  cohort    String   @default("BETA") // "ALPHA" or "BETA"
  questions Question[]
  attempts  QuizAttempt[]
  createdAt DateTime @default(now())
}

model Question {
  id            Int      @id @default(autoincrement())
  questionText  String
  optionA       String
  optionB       String
  optionC       String
  optionD       String
  optionE       String?
  explanationA  String?
  explanationB  String?
  explanationC  String?
  explanationD  String?
  explanationE  String?
  topic         String?
  explanation   String?
  correctAnswer String
  quizId        Int
  quiz          Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  mistakes      UserMistake[]
  bookmarks     UserBookmark[]
  reports       QuestionReport[]
}

model User {
  id        Int       @id @default(autoincrement())
  email     String    @unique
  password  String
  name      String
  role      String    @default("USER")
  cohort    String    @default("BETA") // "ALPHA" or "BETA"
  createdAt DateTime  @default(now())

  mistakes  UserMistake[]
  attempts  QuizAttempt[]
  bookmarks UserBookmark[]
  reports   QuestionReport[]
}

model UserMistake {
  id         Int      @id @default(autoincrement())
  userId     Int
  questionId Int
  createdAt    DateTime @default(now())
  nextReviewAt DateTime @default(now())
  reviewLevel  Int      @default(0)

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
}

model QuizAttempt {
  id        Int      @id @default(autoincrement())
  userId    Int
  quizId    Int
  score     Int
  total     Int
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  quiz      Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
}

model UserBookmark {
  id         Int      @id @default(autoincrement())
  userId          Int
  questionId      Int
  importanceLevel String   @default("IMPORTANT")
  createdAt       DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
}

model QuestionReport {
  id               Int      @id @default(autoincrement())
  questionId       Int
  question         Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  reportedByUserId Int?
  reportedBy       User?    @relation(fields: [reportedByUserId], references: [id], onDelete: SetNull)

  reason           String   // e.g. "WRONG_ANSWER_KEY", "MULTIPLE_CORRECT", "NO_CORRECT", "TYPO_IN_QUESTION", "EXPLANATION_ERROR", "OUTDATED_INFO", "OTHER"
  userNote         String?  // Optional text typed by user if "Other" or note

  status           String   @default("PENDING_AI") // "PENDING_AI", "AUTO_CORRECTED", "NEEDS_ADMIN_REVIEW", "ADMIN_RESOLVED", "DISMISSED"
  aiConfidence     String?  // "HIGH", "MEDIUM", "LOW"
  aiReasoning      String?
  previousAnswer   String?
  suggestedAnswer  String?
  suggestedExplanation String?

  resolvedAt       DateTime?
  resolvedByAdmin  Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([questionId])
  @@index([status])
}
